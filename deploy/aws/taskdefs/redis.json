{
  "family": "allverse-redis",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": __EXECUTION_ROLE_ARN__,
  "taskRoleArn": __TASK_ROLE_ARN__,
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "volumes": [
    {
      "name": "redis-data",
      "efsVolumeConfiguration": {
        "fileSystemId": __EFS_FILE_SYSTEM_ID__,
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": __EFS_AP_REDIS__,
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "redis",
      "image": __IMAGE_REDIS__,
      "essential": true,
      "portMappings": [
        {
          "name": "redis",
          "containerPort": 6379,
          "protocol": "tcp"
        }
      ],
      "command": [
        "redis-server",
        "--appendonly",
        "yes",
        "--dir",
        "/data",
        "--appendfsync",
        "everysec"
      ],
      "mountPoints": [
        {
          "sourceVolume": "redis-data",
          "containerPath": "/data",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "redis-cli ping | grep -q PONG"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": __LOG_GROUP_REDIS__,
          "awslogs-region": __AWS_REGION__,
          "awslogs-stream-prefix": "redis"
        }
      },
      "stopTimeout": 30
    }
  ]
}
