{
  "family": "allverse-mongodb",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": __EXECUTION_ROLE_ARN__,
  "taskRoleArn": __TASK_ROLE_ARN__,
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "volumes": [
    {
      "name": "mongodb-data",
      "efsVolumeConfiguration": {
        "fileSystemId": __EFS_FILE_SYSTEM_ID__,
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": __EFS_AP_MONGODB__,
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "mongodb",
      "image": __IMAGE_MONGODB__,
      "essential": true,
      "portMappings": [
        {
          "name": "mongodb",
          "containerPort": 27017,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MONGO_INITDB_DATABASE",
          "value": "allverse_ai"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "mongodb-data",
          "containerPath": "/data/db",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "mongosh --quiet --eval 'db.adminCommand(\"ping\").ok' | grep -q 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 5,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": __LOG_GROUP_MONGODB__,
          "awslogs-region": __AWS_REGION__,
          "awslogs-stream-prefix": "mongodb"
        }
      },
      "stopTimeout": 120
    }
  ]
}
