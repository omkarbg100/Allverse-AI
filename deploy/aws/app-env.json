{
  "services": {
    "auth": {
      "service": __AUTH_ECS_SERVICE__,
      "container": "auth",
      "environment": {
        "MONGODB_URI": __MONGODB_URI__,
        "REDIS_URL": __REDIS_URL__
      }
    },
    "chat": {
      "service": __CHAT_ECS_SERVICE__,
      "container": "chat",
      "environment": {
        "MONGODB_URI": __MONGODB_URI__,
        "REDIS_URL": __REDIS_URL__
      }
    },
    "billing": {
      "service": __BILLING_ECS_SERVICE__,
      "container": "billing",
      "environment": {
        "MONGODB_URI": __MONGODB_URI__,
        "REDIS_URL": __REDIS_URL__
      }
    },
    "gateway": {
      "service": __GATEWAY_ECS_SERVICE__,
      "container": "gateway",
      "environment": {
        "REDIS_URL": __REDIS_URL__
      }
    },
    "agent": {
      "service": __AGENT_ECS_SERVICE__,
      "container": "agent",
      "environment": {
        "MONGODB_URI": __MONGODB_URI__,
        "REDIS_URL": __REDIS_URL__,
        "QDRANT_URL": __QDRANT_URL__,
        "LITELLM_URL": __LITELLM_URL__,
        "OLLAMA_HOST": __OLLAMA_HOST__,
        "OLLAMA_CHAT_MODEL": __OLLAMA_MODEL__,
        "OLLAMA_CODING_MODEL": __OLLAMA_MODEL__,
        "OLLAMA_VISION_MODEL": __OLLAMA_MODEL__,
        "USE_LITELLM": "true",
        "AWS_REGION": __AWS_REGION__,
        "AWS_BUCKET_NAME": __AGENT_S3_BUCKET__,
        "AWS_ACCESS_KEY_ID": "",
        "AWS_SECRET_KEY": "",
        "MINIO_ENDPOINT": "",
        "S3_PUBLIC_ENDPOINT": ""
      },
      "skipIfEmpty": ["AWS_BUCKET_NAME"],
      "secrets": {
        "LITELLM_API_KEY": __SECRET_LITELLM_MASTER_KEY__,
        "GROQ_API_KEY": __SECRET_GROQ_API_KEY__,
        "TAVILY_API_KEY": __SECRET_TAVILY_API_KEY__
      },
      "taskRoleArn": __AGENT_TASK_ROLE_ARN__
    }
  }
}
