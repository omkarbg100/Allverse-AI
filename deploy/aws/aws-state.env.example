# Copy to aws-state.env (ignored by git) and fill in from bootstrap.sh output.
# Do not commit real credentials. Secrets Manager holds the API keys.

AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
ECS_CLUSTER=allverse-cluster

VPC_ID=vpc-xxxxxxxxxxxxxxxxx
PRIVATE_SUBNET_IDS=subnet-aaaaaaaaaaaaaaaaa,subnet-bbbbbbbbbbbbbbbbb
APP_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
INFRA_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
EFS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

EFS_FILE_SYSTEM_ID=fs-xxxxxxxxxxxxxxxxx
EFS_AP_REDIS=fsap-xxxxxxxxxxxxxxxxx
EFS_AP_MONGODB=fsap-xxxxxxxxxxxxxxxxx
EFS_AP_QDRANT=fsap-xxxxxxxxxxxxxxxxx
EFS_AP_OLLAMA=fsap-xxxxxxxxxxxxxxxxx

ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/allverse-ecs-task-execution
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/allverse-task-role
LITELLM_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:allverse/litellm-xxxxxx

CLOUDMAP_NAMESPACE=allverse.local
SERVICE_DISCOVERY_REDIS_ARN=arn:aws:servicediscovery:ap-south-1:123456789012:service/srv-xxxxxxxxxxxxxxxxx
SERVICE_DISCOVERY_MONGODB_ARN=arn:aws:servicediscovery:ap-south-1:123456789012:service/srv-xxxxxxxxxxxxxxxxx
SERVICE_DISCOVERY_QDRANT_ARN=arn:aws:servicediscovery:ap-south-1:123456789012:service/srv-xxxxxxxxxxxxxxxxx
SERVICE_DISCOVERY_LITELLM_ARN=arn:aws:servicediscovery:ap-south-1:123456789012:service/srv-xxxxxxxxxxxxxxxxx
SERVICE_DISCOVERY_OLLAMA_ARN=arn:aws:servicediscovery:ap-south-1:123456789012:service/srv-xxxxxxxxxxxxxxxxx

# Optional
# AGENT_S3_BUCKET=allverse-agent-files-123456789012
# OLLAMA_MODEL=llama3.2:3b
# REDIS_IMAGE_TAG=7
# MONGODB_IMAGE_TAG=7
# QDRANT_IMAGE_TAG=latest
# OLLAMA_IMAGE_TAG=latest
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_GPU_COUNT=1
