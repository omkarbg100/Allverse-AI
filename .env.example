# =================================================================
#  Allverse AI — Unified Docker Compose Environment Configuration
# =================================================================

COMPOSE_PROJECT_NAME=allverse-ai

# ── LLM: Groq (primary) + LiteLLM (proxy) ───────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
LITELLM_MASTER_KEY=sk-allverse-litellm-master-key

# ── Web Search Tool ──────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Local Development Auth ───────────────────────────────────────
# Enables "Continue as Demo User" when Firebase credentials are absent.
# Set to false and configure Firebase for real authentication.
ALLOW_DEV_LOGIN=true
VITE_FIREBASE_API_KEY=

# ── Frontend & Gateway Ports ─────────────────────────────────────
FRONTEND_PORT=5173
GATEWAY_PORT=8000
VITE_SERVER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Internal Service Ports & URLs ────────────────────────────────
AGENT_PORT=8003
AGENT_SERVICE=http://agent:8003
AUTH_SERVICE=http://auth:8001
CHAT_SERVICE=http://chat:8002
BILLING_SERVICE=http://billing:8004

# ── Databases & Infrastructure ───────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017/allverse_ai
REDIS_URL=redis://redis:6379
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── Object Storage (Local MinIO / S3) ────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_KEY=minioadmin
AWS_BUCKET_NAME=agent-files
AWS_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000

# ── Payment Gateway (Optional) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder


# Public URL used for browser-facing presigned S3 links
S3_PUBLIC_ENDPOINT=
